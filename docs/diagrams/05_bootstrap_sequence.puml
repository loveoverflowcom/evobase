@startuml Evobase_Admin_Database_Bootstrap_Sequence
!theme materia
autonumber

actor "Admin" as Admin
participant "Workbench / Admin Client" as Client
participant "Gateway Handler" as Handler
participant "DatabaseManager" as Manager
participant "PostgresDatabaseProvisioner" as Provisioner
database "PostgreSQL Admin DB\n(DATABASE_ADMIN_URL)" as AdminDb
database "Target PostgreSQL DB" as TargetDb

Admin -> Client: Submit bootstrap form\n(database_id + SQL scripts)
Client -> Handler: POST /admin/databases
Handler -> Manager: bootstrap_database(request)
Manager -> Manager: validate + reserve logical id
Manager -> Provisioner: provision_database(request)
Provisioner -> AdminDb: create database / verify existing
Provisioner -> TargetDb: connect target database
Provisioner -> TargetDb: execute SQL scripts in order
Provisioner -->> Manager: storage handle or bootstrap failure
Manager -> TargetDb: introspect schema via StorageAdapter

alt Introspection succeeds
    Manager -> Manager: register database as ready
    Manager -->> Handler: ManagedDatabase(status=ready)
    Handler -->> Client: 200 ApiResponse<DatabaseDto>
    Client -> Handler: GET /admin/databases/{id}/docs
    Handler -> Manager: describe_tables(id)
    Manager -> TargetDb: introspect live schema
    Handler -->> Client: ApiDocsDto
else Any bootstrap stage fails
    Manager -> Manager: register database as bootstrap_failed
    Manager -->> Handler: ManagedDatabase(status=bootstrap_failed)
    Handler -->> Client: 200 ApiResponse<DatabaseDto>
end
@enduml

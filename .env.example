SERVER_ADDR=0.0.0.0:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/evobase
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
DATABASE_DEFAULT_ID=default
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
NOTIFICATION_TOKEN_SECRET=replace-with-another-long-random-string
ADMIN_TOKEN=replace-with-admin-token
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=2592000
NOTIFICATION_TOKEN_TTL_SECS=2592000
RUST_LOG=info,evobase_server=debug,evobase_gateway=debug

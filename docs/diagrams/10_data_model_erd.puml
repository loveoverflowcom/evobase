@startuml Evobase_Data_Model_ERD
!theme toy
hide methods
hide stereotypes

entity "auth.users" as users {
  * id : uuid <<PK>>
  --
  username : text <<UNIQUE>>
  password_hash : text
  created_at : timestamptz
}

entity "public.notes" as notes {
  * id : uuid <<PK>>
  --
  owner_id : uuid <<FK>>
  body : text
  created_at : timestamptz
}

users ||--o{ notes : owns

note right of notes
  RLS enabled on public.notes

  USING:
  owner_id = current_setting(
    'request.jwt.claim.sub', true
  )::uuid

  WITH CHECK:
  owner_id = current_setting(
    'request.jwt.claim.sub', true
  )::uuid
end note
@enduml

@startuml Evobase_Core_Contracts
!theme toy
skinparam linetype ortho

package "evobase-core" {
    interface AuthService {
        +register(request)
        +login(request)
        +refresh(refresh_token)
        +verify_access_token(token)
        +verify_notification_token(token)
    }

    interface StorageAdapter {
        +create_user(username, password_hash)
        +find_user_by_username(username)
        +find_user_by_id(user_id)
        +select_rows(request, auth)
        +insert_rows(request, auth)
        +update_rows(request, auth)
        +delete_rows(request, auth)
    }

    interface MessagingService {
        +connect(user_id)
        +disconnect(user_id, connection_id)
        +send(user_id, event)
    }

    class AuthContext
    class TokenBundle
    class ServerEvent
    class UserRecord
}

package "Implementations" {
    class JwtAuthService
    class PostgresStorage
    class InMemoryMessagingHub
    class AppState {
        +auth_service
        +messaging_service
        +storage
    }
}

JwtAuthService ..|> AuthService
PostgresStorage ..|> StorageAdapter
InMemoryMessagingHub ..|> MessagingService

JwtAuthService --> StorageAdapter : load/create users
AppState o--> AuthService
AppState o--> MessagingService
AppState o--> StorageAdapter

AuthService --> AuthContext
AuthService --> TokenBundle
MessagingService --> ServerEvent
StorageAdapter --> UserRecord
StorageAdapter --> AuthContext
@enduml

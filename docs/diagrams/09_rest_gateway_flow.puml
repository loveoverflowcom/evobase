@startuml Eonbase_REST_Gateway_Flow
!theme materia
autonumber

actor Client
participant "Gateway Route\n/rest/{table}" as GTW
participant "JWT Middleware" as MW
participant "REST Parser" as Parser
participant "PostgresStorage" as Store
database "PostgreSQL" as PG

Client -> GTW: GET|POST|PATCH|DELETE /rest/public.notes?... + Bearer token
GTW -> MW: require_access_token(...)
MW -> MW: verify access token
MW -->> GTW: AuthContext { user_id }

alt GET
    GTW -> Parser: parse_select_request(table, query)
    Parser -> Parser: validate identifiers\nparse select/order/filter/limit/offset
    Parser -->> GTW: TableSelect
    GTW -> Store: select_rows(request, auth)
else POST
    GTW -> Parser: parse_insert_request(table, body)
    Parser -> Parser: object | array<object>
    Parser -->> GTW: TableInsert
    GTW -> Store: insert_rows(request, auth)
else PATCH
    GTW -> Parser: parse_update_request(table, query, body)
    Parser -> Parser: require at least one filter
    Parser -->> GTW: TableUpdate
    GTW -> Store: update_rows(request, auth)
else DELETE
    GTW -> Parser: parse_delete_request(table, query)
    Parser -> Parser: require at least one filter
    Parser -->> GTW: TableDelete
    GTW -> Store: delete_rows(request, auth)
end

group SQL execution
    Store -> PG: BEGIN
    Store -> PG: set_config('request.jwt.claim.sub', user_id, true)
    Store -> PG: run QueryBuilder-generated SQL
    PG -> PG: apply GRANT + RLS
    PG -->> Store: JSON rows / SQL error
    Store -> PG: COMMIT or ROLLBACK
end

Store -->> GTW: Vec<serde_json::Value>
GTW -->> Client: JSON response
@enduml

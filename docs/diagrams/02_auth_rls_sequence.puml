@startuml Evobase_Auth_RLS_Sequence
!theme materia
autonumber

actor Client
participant "Gateway Middleware" as MW
participant "Auth Service" as Auth
participant "PostgresStorage" as DB
database "PostgreSQL" as PG

Client -> MW: HTTP Request + Authorization: Bearer <access_token>
MW -> Auth: verify_access_token(token)
Auth -->> MW: AuthContext { user_id }

MW -> DB: select_rows / insert_rows / update_rows / delete_rows
group Transaction scoped to request
    DB -> PG: BEGIN
    DB -> PG: set_config('request.jwt.claim.sub', user_id, true)
    DB -> PG: set_config('app.current_user_id', user_id, true)
    note right
      Gateway khong tu quyet dinh quyen truy cap du lieu.
      PostgreSQL tu danh gia GRANT + RLS dua tren claim da inject.
    end note
    DB -> PG: SELECT / INSERT / UPDATE / DELETE ...
    PG -> PG: Evaluate GRANT + RLS policy
    alt Permission granted
        PG -->> DB: Rows / affected records
        DB -> PG: COMMIT
    else Permission denied
        PG -->> DB: SQL error / blocked by policy
        DB -> PG: ROLLBACK
    end
end

DB -->> MW: JSON rows or error
MW -->> Client: HTTP JSON Response
@enduml
